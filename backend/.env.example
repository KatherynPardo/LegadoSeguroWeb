# Copia este archivo, renómbralo a ".env" y reemplaza los valores.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).

# Supabase -> botón "Connect" -> pestaña "Connection String" -> "Session pooler"
# Reemplaza [YOUR-PASSWORD] por la contraseña de tu base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

PORT=5000

# TRUST_PROXY (opcional): cuántos proxies hay delante del backend. Déjalo en 0 en tu computadora y pon 1 al desplegar
# en la nube (Render, Railway...), para que la IP registrada sea la real y no la del proxy.
TRUST_PROXY=0

# JWT_SECRET (opcional): clave para firmar las sesiones. Pon una cadena larga y secreta.
JWT_SECRET=cambia-esto-por-una-clave-larga


# Consulta de DNI (opcional). Proveedor: apisnetpe (apis.net.pe) o apiperu (apiperu.dev).
# Sin token, el boton Buscar avisa que no esta configurado y los datos se escriben a mano.
DNI_PROVIDER=apisnetpe
DNI_API_TOKEN=


# Clave para cifrar montos y descripciones de los activos. Pon una frase larga y NO la cambies después.
ENCRYPTION_KEY=cambia-esto-por-otra-frase-larga

# Cobro del plan Premium con Niubiz (opcional). Las credenciales las entrega Niubiz al afiliar el comercio.
# Sin ellas, el botón de pago avisa que no está configurado. NIUBIZ_ENV: test (sandbox) o prod.
NIUBIZ_MERCHANT_ID=
NIUBIZ_USER=
NIUBIZ_PASSWORD=
NIUBIZ_ENV=test
# Direcciones públicas (en local no hace falta cambiarlas): donde Niubiz devuelve el resultado y a donde vuelve el usuario.
API_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:4200

# Correo para enviar los códigos de verificación (opcional).
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
# Sin SMTP_HOST, el código aparece en la consola del backend (sirve para probar y exponer).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
SMTP_FROM=LegadoSeguro <tucorreo@gmail.com>

# Datos del comercio para el comprobante de pago (razón social, RUC de 11 dígitos y dirección fiscal)
COMERCIO_RAZON_SOCIAL=
COMERCIO_RUC=
COMERCIO_DIRECCION=
