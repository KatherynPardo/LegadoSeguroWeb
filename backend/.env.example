# Copia este archivo, renómbralo a ".env" y reemplaza los valores.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).

# Supabase -> botón "Connect" -> pestaña "Connection String" -> "Session pooler"
# Reemplaza [YOUR-PASSWORD] por la contraseña de tu base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

PORT=5000
